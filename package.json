{
  "name": "cla-bot",
  "version": "0.1.1",
  "private": true,
  "description": "Lightweight GitHub CLA enforcement bot.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && ncc build .build/index.js -o dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1",
    "yaml": "^2.8.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vercel/ncc": "^0.38.4",
    "typescript": "^6.0.2",
    "vite": "^8.1.6",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "undici": "^6.29.1",
      "postcss": "^8.5.23",
      "source-map-js": "^1.2.2",
      "esbuild": "^0.28.1",
      "@vitest/mocker": "^4.1.11"
    }
  }
}
